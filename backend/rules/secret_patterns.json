[
    {
        "id": "AWS001",
        "name": "AWS Access Key",
        "description": "Potential AWS Access Key detected.",
        "severity": "Critical",
        "category": "Cloud",
        "pattern": "AKIA[0-9A-Z]{16}",
        "recommendation": "Rotate the AWS Access Key immediately."
    },
    {
        "id": "GITHUB001",
        "name": "GitHub Personal Access Token",
        "description": "Potential GitHub token detected.",
        "severity": "Critical",
        "category": "Version Control",
        "pattern": "ghp_[A-Za-z0-9]{36}",
        "recommendation": "Revoke and regenerate the GitHub token."
    },
    {
        "id": "JWT001",
        "name": "JWT Token",
        "description": "Potential JWT token detected.",
        "severity": "Medium",
        "category": "Authentication",
        "pattern": "eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9._-]+\\.[A-Za-z0-9._-]+",
        "recommendation": "Avoid storing JWT tokens inside source code."
    },
    {
        "id": "PRIVATEKEY001",
        "name": "Private Key",
        "description": "Private key detected.",
        "severity": "Critical",
        "category": "Certificates",
        "pattern": "-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----",
        "recommendation": "Remove the private key and rotate associated credentials."
    },
    {
        "id": "SLACK001",
        "name": "Slack Token",
        "description": "Slack token detected.",
        "severity": "High",
        "category": "Communication",
        "pattern": "xox[baprs]-[A-Za-z0-9-]+",
        "recommendation": "Revoke the Slack token and create a new one."
    }
]